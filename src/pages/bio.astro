---
/**
 * Artist Bio & Studio Practice Page (/bio)
 * 
 * Editorial artist profile for Jacob Brook detailing his relief printmaking practice,
 * the reduction linocut method, physical materials, and studio philosophy.
 * 
 * @page
 */

import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import ContactFormModal from '../components/ContactFormModal';
import ExhibitionsList from '../components/ExhibitionsList';
import { DOMAINS } from '../lib/urls';
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <title>Bio & Studio Practice — Jacob Brook</title>
    <meta 
      name="description" 
      content="Artist biography and studio practice of Jacob Brook — multi-layer reduction linocut printmaker and software craftsman." 
    />
    <ClientRouter />
  </head>
  <body class="min-h-screen flex flex-col justify-between">
    <Navigation activeDomain="bio" />

    <main class="flex-grow max-w-5xl mx-auto px-4 sm:px-6 py-12 sm:py-16">
      
      <!-- Top Header & Breadcrumb -->
      <div class="mb-12 border-b border-paper-border dark:border-carbon-border pb-8">
        <span class="text-xs uppercase tracking-widest font-semibold text-paper-accent dark:text-carbon-accent font-mono">
          About the Artist
        </span>
        <h1 class="font-serif text-4xl sm:text-5xl font-extrabold text-paper-text dark:text-carbon-text mt-2">
          Jacob Brook
        </h1>
        <p class="text-lg text-paper-muted dark:text-carbon-muted mt-2 font-serif">
          Printmaker & Software Craftsman
        </p>
      </div>

      <!-- Main Layout: Sidebar with Portrait & Specifications + Main Narrative Body -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
        
        <!-- Left Column: Portrait & Studio Spec Placard -->
        <aside class="lg:col-span-4 flex flex-col gap-6">
          <!-- Portrait Frame -->
          <div class="relative bg-paper-bg dark:bg-carbon-bg border border-paper-border dark:border-carbon-border rounded-2xl p-3 shadow-sm overflow-hidden">
            <div class="aspect-[4/5] rounded-xl overflow-hidden bg-paper-border/20 dark:bg-carbon-border/20">
              <img 
                src="/avatar.jpg" 
                alt="Jacob Brook in the studio" 
                class="w-full h-full object-cover"
                loading="eager"
              />
            </div>
            <div class="p-3 text-center">
              <p class="font-serif font-bold text-paper-text dark:text-carbon-text text-base">
                Jacob Brook
              </p>
              <p class="text-xs text-paper-muted dark:text-carbon-muted mt-0.5 font-mono">
                Studio & Press
              </p>
            </div>
          </div>

          <!-- Studio Specifications Card -->
          <div class="p-6 bg-paper-bg dark:bg-carbon-bg border border-paper-border dark:border-carbon-border rounded-xl space-y-4">
            <h2 class="text-xs font-mono uppercase tracking-widest font-semibold text-paper-accent dark:text-carbon-accent">
              Studio Specifications
            </h2>

            <div class="space-y-3 text-xs">
              <div>
                <span class="font-semibold text-paper-text dark:text-carbon-text block">Primary Medium</span>
                <span class="text-paper-muted dark:text-carbon-muted">Multi-layer reduction linocut</span>
              </div>
              <div>
                <span class="font-semibold text-paper-text dark:text-carbon-text block">Paper Stock</span>
                <span class="text-paper-muted dark:text-carbon-muted">Legion Stonehenge & Rives BFK (100% cotton rag)</span>
              </div>
              <div>
                <span class="font-semibold text-paper-text dark:text-carbon-text block">Inks</span>
                <span class="text-paper-muted dark:text-carbon-muted">Lightfast oil-based relief inks</span>
              </div>
              <div>
                <span class="font-semibold text-paper-text dark:text-carbon-text block">Press Method</span>
                <span class="text-paper-muted dark:text-carbon-muted">Hand-carved linoleum, pin registration, hand-pulled</span>
              </div>
              <div>
                <span class="font-semibold text-paper-text dark:text-carbon-text block">Edition Policy</span>
                <span class="text-paper-muted dark:text-carbon-muted">Strictly limited; block destroyed in the reduction process</span>
              </div>
            </div>

            <div class="pt-4 border-t border-paper-border dark:border-carbon-border flex flex-col gap-2">
              <a 
                href={DOMAINS.prints}
                class="inline-flex items-center justify-center gap-1.5 px-4 py-2.5 rounded-lg bg-paper-accent dark:bg-carbon-accent text-white font-mono text-xs font-semibold tracking-wide hover:opacity-90 active:scale-95 transition-all text-center"
              >
                Browse Original Prints &rarr;
              </a>

              <ContactFormModal
                client:load
                sourceSubdomain="bio"
                triggerButtonText="Inquire / Contact Studio"
                triggerButtonClassName="w-full inline-flex items-center justify-center gap-1.5 px-4 py-2.5 rounded-lg border border-paper-border dark:border-carbon-border text-paper-text dark:text-carbon-text font-mono text-xs font-semibold tracking-wide hover:border-paper-accent dark:hover:border-carbon-accent hover:text-paper-accent dark:hover:text-carbon-accent transition-all cursor-pointer text-center"
              />
            </div>
          </div>
        </aside>

        <!-- Right Column: Narrative Biography & Artist Statement -->
        <article class="lg:col-span-8 flex flex-col gap-8 font-serif text-paper-text dark:text-carbon-text leading-relaxed">
          
          <!-- Section 1: The Practice & Reduction Method -->
          <section class="space-y-3">
            <h2 class="text-2xl sm:text-3xl font-bold tracking-tight">
              The Reduction Method
            </h2>
            <p class="text-base sm:text-lg text-paper-muted dark:text-carbon-muted leading-relaxed">
              Jacob Brook is a relief printmaker and software craftsman. His studio practice centers on multi-layer reduction linocut—an exacting, irreversible process where an entire edition of colored prints is pulled from a single block of linoleum.
            </p>
            <p class="text-base text-paper-muted dark:text-carbon-muted leading-relaxed">
              With each color pass, the surface is carved away to protect the preceding tone before the next ink layer is hand-pulled onto archival paper. By the final impression, the block is physically exhausted. Because the matrix is destroyed in the act of making, an edition can never be reprinted.
            </p>
          </section>

          <!-- Section 2: Craft & Computation -->
          <section class="space-y-3 pt-6 border-t border-paper-border dark:border-carbon-border">
            <h2 class="text-2xl sm:text-3xl font-bold tracking-tight">
              Craft & Computation
            </h2>
            <p class="text-base text-paper-muted dark:text-carbon-muted leading-relaxed">
              Printmaking serves as a physical counterweight to the digital realm. In software, mistakes can be undone with a keystroke; in relief carving, a gouge through linoleum is permanent.
            </p>
            <p class="text-base text-paper-muted dark:text-carbon-muted leading-relaxed">
              Jacob designs custom algorithms—from palette reduction scripts to directional luminance models—to test tonal separations before carving. Crucially, computation serves only to inform the eye. The physical cutting, inking, and press work remain entirely by hand.
            </p>
          </section>

          <!-- Section 3: Archival Editions -->
          <section class="space-y-3 pt-6 border-t border-paper-border dark:border-carbon-border">
            <h2 class="text-2xl sm:text-3xl font-bold tracking-tight">
              Archival Standards
            </h2>
            <p class="text-base text-paper-muted dark:text-carbon-muted leading-relaxed">
              All prints are pulled on 100% cotton rag paper (Stonehenge and Rives BFK) using lightfast, oil-based relief inks. Each impression in an edition is individually inspected, titled, numbered, and signed by hand.
            </p>
          </section>

          <!-- Section 4: Dynamic Shows & Exhibitions List -->
          <ExhibitionsList client:load />

          <!-- Studio Inquiries Callout -->
          <section class="mt-4 p-8 rounded-2xl bg-paper-accent/5 dark:bg-carbon-accent/5 border border-paper-accent/20 dark:border-carbon-accent/20 flex flex-col sm:flex-row items-center justify-between gap-6">
            <div>
              <h3 class="text-xl font-bold text-paper-text dark:text-carbon-text">
                Studio Inquiries & Commissions
              </h3>
              <p class="text-sm text-paper-muted dark:text-carbon-muted mt-1 max-w-md">
                For inquiries regarding original prints, custom relief editions, or exhibition requests, feel free to reach out.
              </p>
            </div>

            <ContactFormModal
              client:load
              sourceSubdomain="bio"
              triggerButtonText="Get in Touch"
              triggerButtonClassName="px-6 py-3 rounded-xl bg-paper-accent dark:bg-carbon-accent text-white font-mono text-xs font-semibold tracking-wide hover:opacity-90 active:scale-95 transition-all shadow-sm whitespace-nowrap cursor-pointer shrink-0"
            />
          </section>

        </article>

      </div>

    </main>

    <Footer />
  </body>
</html>
