---
/**
 * Blog Section Index Page (/blog)
 * 
 * Renders an article-first feed of essays spanning physical printmaking craft,
 * digital design systems, web platforms, and type-safe web architecture.
 * 
 * @page
 */

import Navigation from '../../components/Navigation.astro';
import Footer from '../../components/Footer.astro';
import { getAllBlogPosts } from '../../lib/hygraph';
import '../../styles/global.css';

const posts = await getAllBlogPosts();
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Essays & Studio Notes — Jacob Brook</title>
    <meta 
      name="description" 
      content="Articles and technical write-ups exploring relief printmaking, design tokens, and web system architecture." 
    />
  </head>
  <body class="min-h-screen flex flex-col justify-between">
    <Navigation activeDomain="blog" />

    <main class="flex-grow max-w-4xl mx-auto px-4 sm:px-6 py-12">
      <header class="mb-12 border-b border-paper-border dark:border-carbon-border pb-8">
        <span class="text-xs font-serif uppercase tracking-widest font-semibold text-paper-accent dark:text-carbon-accent">
          Editorial Writing
        </span>
        <h1 class="font-serif text-4xl sm:text-5xl font-extrabold text-paper-text dark:text-carbon-text mt-2">
          Essays & Studio Notes
        </h1>
        <p class="text-lg text-paper-muted dark:text-carbon-muted mt-3 font-serif">
          Writing at the intersection of physical printmaking discipline, modern TypeScript monorepos, and design systems.
        </p>
      </header>

      <!-- Articles Feed -->
      <section class="space-y-10">
        {posts.map((post) => (
          <article class="group p-6 sm:p-8 bg-paper-bg dark:bg-carbon-bg border border-paper-border dark:border-carbon-border rounded-xl focus-tactile transition-all">
            <div class="flex items-center gap-3 text-xs font-mono text-paper-muted dark:text-carbon-muted mb-3">
              <span class="uppercase tracking-wider font-semibold text-paper-accent dark:text-carbon-accent">
                {post.category}
              </span>
              <span>•</span>
              <span>{post.publishedAt}</span>
              <span>•</span>
              <span>{post.readTimeMinutes} min read</span>
            </div>

            <h2 class="font-serif text-2xl sm:text-3xl font-bold text-paper-text dark:text-carbon-text group-hover:text-paper-accent dark:group-hover:text-carbon-accent transition-colors">
              <a href={`/blog/${post.slug}`}>
                {post.title}
              </a>
            </h2>

            <p class="text-base text-paper-muted dark:text-carbon-muted mt-3 leading-relaxed font-serif">
              {post.excerpt}
            </p>

            <div class="mt-6 pt-4 border-t border-paper-border/60 dark:border-carbon-border/60 flex items-center justify-between">
              <div class="flex items-center gap-3">
                <img 
                  src={post.author.avatarUrl} 
                  alt={post.author.name} 
                  onerror="if(!this.dataset.retried){this.dataset.retried='1';this.src='/avatar.jpg.jpg';}else{this.style.display='none';}"
                  class="w-7 h-7 rounded-full object-cover"
                />
                <span class="text-xs font-medium text-paper-text dark:text-carbon-text">
                  {post.author.name}
                </span>
              </div>

              <a 
                href={`/blog/${post.slug}`} 
                class="text-xs font-semibold text-paper-accent dark:text-carbon-accent group-hover:translate-x-1 transition-transform inline-flex items-center gap-1"
              >
                Read Article &rarr;
              </a>
            </div>
          </article>
        ))}
      </section>
    </main>

    <Footer />
  </body>
</html>
