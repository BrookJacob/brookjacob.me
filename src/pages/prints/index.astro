---
/**
 * Printmaking Gallery Feed Page (printmaker.brookjacob.studio)
 * 
 * Displays visual gallery of relief printmaking editions and studio works,
 * alongside studio contact integration.
 * 
 * @page
 */

import Navigation from '../../components/Navigation.astro';
import Footer from '../../components/Footer.astro';
import PotentialPrintsAccordion from '../../components/PotentialPrintsAccordion';
import ContactFormModal from '../../components/ContactFormModal';
import { ArtworkGalleryFeed } from '../../components/ArtworkGalleryFeed';
import { getAllArtworks } from '../../lib/hygraph';
import { fetchPotentialPrints, partitionPotentialPrints } from '../../lib/potentialPrints';
import { ClientRouter } from 'astro:transitions';
import '../../styles/global.css';

// Fetch artwork list and potential prints statically at build time (Astro SSG)
const [artworks, potentialPrints] = await Promise.all([
  getAllArtworks(),
  fetchPotentialPrints(),
]);

const { inProductionPrint } = partitionPotentialPrints(potentialPrints);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <title>Printmaking Studio — Jacob Brook</title>
    <meta 
      name="description" 
      content="Original multi-layer reduction linocuts hand-carved and hand-pressed on archival paper by Jacob Brook." 
    />
    <ClientRouter />
  </head>
  <body class="min-h-screen flex flex-col justify-between">
    <Navigation activeDomain="prints" />

    <main class="flex-grow max-w-6xl mx-auto px-4 sm:px-6 py-12">
      <!-- Gallery Feed Header & Contact Action -->
      <section class="mb-8 border-b border-paper-border dark:border-carbon-border pb-8 flex flex-col md:flex-row md:items-end justify-between gap-6">
        <div>
          <span class="text-xs uppercase tracking-widest font-semibold text-paper-accent dark:text-carbon-accent font-mono">
            Original Editions
          </span>
          <h1 class="font-serif text-4xl sm:text-5xl font-extrabold text-paper-text dark:text-carbon-text mt-2">
            Printmaking Studio
          </h1>
          <p class="text-base sm:text-lg text-paper-muted dark:text-carbon-muted mt-3 max-w-3xl font-serif">
            Multi-layer reduction linocuts carved and hand-pressed from a single block on archival cotton rag.
          </p>
        </div>

        <div>
          <ContactFormModal
            client:load
            sourceSubdomain="print"
            triggerButtonText="Studio Inquiries"
            triggerButtonClassName="px-4 py-2.5 border border-paper-text/70 dark:border-carbon-text/70 hover:bg-paper-text hover:text-paper-bg dark:hover:bg-carbon-text dark:hover:text-carbon-bg text-paper-text dark:text-carbon-text font-mono text-xs tracking-wider uppercase transition-colors flex items-center gap-2 whitespace-nowrap cursor-pointer"
          />
        </div>
      </section>

      <!-- Understated Studio Studies & Voting Accordion -->
      <PotentialPrintsAccordion client:load initialPrints={potentialPrints} />

      <!-- Published Artwork Progressive Feed (with in-progress print included seamlessly) -->
      <ArtworkGalleryFeed client:load artworks={artworks} inProductionPrint={inProductionPrint} />
    </main>

    <Footer />
  </body>
</html>
