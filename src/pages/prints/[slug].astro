---
/**
 * Artwork Detail Page (/prints/[slug])
 * 
 * Renders high-res image zoom lightbox via Radix UI client component,
 * alongside a museum-style metadata placard detailing paper stock, block dimensions,
 * edition numbers, and process notes.
 * 
 * @page
 */

import Navigation from '../../components/Navigation.astro';
import Footer from '../../components/Footer.astro';
import MuseumPlacard from '../../components/MuseumPlacard.astro';
import { LightboxModal } from '../../components/LightboxModal';
import { getAllArtworks, getArtworkBySlug } from '../../lib/hygraph';
import '../../styles/global.css';

/**
 * Generates static paths for all artwork items during SSG compilation.
 */
export async function getStaticPaths() {
  const artworks = await getAllArtworks();
  return artworks.map((artwork) => ({
    params: { slug: artwork.slug },
  }));
}

const { slug } = Astro.params;
const artwork = await getArtworkBySlug(slug as string);

if (!artwork) {
  return Astro.redirect('/prints');
}
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{artwork.title} ({artwork.year}) — Printmaking Detail</title>
    <meta 
      name="description" 
      content={`${artwork.title} - ${artwork.technique} on ${artwork.paperStock}. Edition of ${artwork.editionSize}.`} 
    />
  </head>
  <body class="min-h-screen flex flex-col justify-between">
    <Navigation activeDomain="prints" />

    <main class="flex-grow max-w-6xl mx-auto px-4 sm:px-6 py-10 sm:py-16">
      
      <!-- Back Link -->
      <div class="mb-8">
        <a 
          href="/prints" 
          class="inline-flex items-center gap-2 text-xs font-semibold uppercase tracking-wider text-paper-muted dark:text-carbon-muted hover:text-paper-text dark:hover:text-carbon-text transition-colors"
        >
          &larr; Return to Printmaking Gallery
        </a>
      </div>

      <!-- Main Detail Grid Layout: High-Res Lightbox View vs Museum Placard -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">
        
        <!-- Left Column: High-Res Image with Radix UI Lightbox Zoom Modal (Client Hydrated) -->
        <div class="lg:col-span-7 flex flex-col gap-3">
          <LightboxModal 
            client:load 
            src={artwork.coverImage.url} 
            alt={artwork.coverImage.altText || artwork.title} 
            blurhash={artwork.coverImage.blurhash}
            title={artwork.title}
            technique={artwork.technique}
          />
          <p class="text-xs text-center text-paper-muted dark:text-carbon-muted italic">
            Click image above to activate full-screen high-resolution lightbox zoom modal.
          </p>
        </div>

        <!-- Right Column: Museum Placard Card -->
        <div class="lg:col-span-5">
          <MuseumPlacard 
            placard={{
              title: artwork.title,
              year: artwork.year,
              technique: artwork.technique,
              paperStock: artwork.paperStock,
              editionSize: artwork.editionSize,
              blockDimensions: artwork.blockDimensions,
              processNotes: artwork.processNotes,
            }}
          />
        </div>

      </div>

    </main>

    <Footer />
  </body>
</html>
