---
/**
 * Artwork Detail Page (/prints/[slug])
 * 
 * Renders high-res image zoom lightbox via Radix UI client component,
 * alongside a museum-style metadata placard detailing paper stock, block dimensions,
 * edition numbers, and process notes.
 * 
 * @page
 */

import Navigation from '../../components/Navigation.astro';
import Footer from '../../components/Footer.astro';
import MuseumPlacard from '../../components/MuseumPlacard.astro';
import { InteractiveImageViewer } from '../../components/InteractiveImageViewer';
import { getAllArtworks, getArtworkBySlug } from '../../lib/hygraph';
import '../../styles/global.css';

/**
 * Generates static paths for all artwork items during SSG compilation.
 */
export async function getStaticPaths() {
  const artworks = await getAllArtworks();
  return artworks.map((artwork) => ({
    params: { slug: artwork.slug },
  }));
}

const { slug } = Astro.params;
const artwork = await getArtworkBySlug(slug as string);

if (!artwork) {
  return Astro.redirect('/');
}
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <title>{`${artwork.title} (${artwork.year}) — Printmaking Detail`}</title>
    <meta 
      name="description" 
      content={`${artwork.title} - ${artwork.technique} on ${artwork.paperStock}. Edition of ${artwork.editionSize}.`} 
    />
  </head>
  <body class="min-h-screen flex flex-col justify-between">
    <Navigation activeDomain="prints" />

    <main class="flex-grow max-w-6xl mx-auto w-full px-4 sm:px-6 py-4 sm:py-6 flex flex-col justify-center min-h-[calc(100vh-8rem)]">
      
      <!-- Back Link -->
      <div class="mb-4">
        <a 
          href="/" 
          class="inline-flex items-center gap-2 text-xs font-semibold uppercase tracking-wider text-paper-muted dark:text-carbon-muted hover:text-paper-text dark:hover:text-carbon-text transition-colors"
        >
          &larr; Return to Printmaking Gallery
        </a>
      </div>

      <!-- Main Detail Grid Layout: In-Page Pan & Zoom Interactive Image Viewer vs Museum Placard -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-8 items-start">
        
        <!-- Left Column: In-Page Pan & Zoom Interactive Image Viewer (Client Hydrated) -->
        <div class="lg:col-span-7 flex flex-col gap-2">
          <InteractiveImageViewer 
            client:load 
            mainImage={artwork.coverImage}
            galleryImages={artwork.galleryImages}
            alt={artwork.coverImage.altText || artwork.title}
          />
        </div>

        <!-- Right Column: Museum Placard Card with Process Photos Carousel -->
        <div class="lg:col-span-5">
          <MuseumPlacard 
            placard={{
              title: artwork.title,
              year: artwork.year,
              technique: artwork.technique,
              paperStock: artwork.paperStock,
              editionSize: artwork.editionSize,
              blockDimensions: artwork.blockDimensions,
              processNotes: artwork.processNotes,
              processImages: artwork.processImages,
            }}
          />
        </div>

      </div>

    </main>

    <Footer />
  </body>
</html>
