---
/**
 * Project Detail Page (/code/[slug])
 * 
 * Deep-dive architectural breakdown page for individual software engineering projects.
 * 
 * @page
 */

import Navigation from '../../components/Navigation.astro';
import Footer from '../../components/Footer.astro';
import { QuantizationStudio } from '../../components/QuantizationStudio';
import ArtworkCard from '../../components/ArtworkCard.astro';
import { getAllProjects, getProjectBySlug, getAllArtworks } from '../../lib/hygraph';
import { DOMAINS, getPrintUrl } from '../../lib/urls';
import '../../styles/global.css';

/**
 * Generates static paths for software projects.
 */
export async function getStaticPaths() {
  const projects = await getAllProjects();
  return projects.map((project) => ({
    params: { slug: project.slug },
  }));
}

const { slug } = Astro.params;
const project = await getProjectBySlug(slug as string);

if (!project) {
  return Astro.redirect('/');
}

// Fetch physical printmaking artworks for cross-linking (excluding "Woman")
const allArtworks = await getAllArtworks();
const relatedPrints = allArtworks.filter(
  (art) => art.title.toLowerCase() !== 'woman' && art.slug.toLowerCase() !== 'woman'
);

const hasExternalLiveUrl = Boolean(
  project.liveUrl &&
  !project.liveUrl.includes('brookjacob.studio') &&
  !project.liveUrl.includes('brookjacob.me') &&
  !project.liveUrl.startsWith('/')
);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{project.title} — Software Architecture Case Study</title>
    <meta name="description" content={project.description} />
  </head>
  <body class="min-h-screen flex flex-col justify-between overflow-x-hidden">
    <Navigation activeDomain="code" />

    <main class="flex-grow max-w-4xl w-full mx-auto px-4 sm:px-6 py-12 min-w-0">
      <!-- Return Navigation -->
      <div class="mb-8">
        <a 
          href="/" 
          class="inline-flex items-center gap-2 text-xs font-semibold uppercase tracking-wider text-paper-muted dark:text-carbon-muted hover:text-paper-text dark:hover:text-carbon-text transition-colors"
        >
          &larr; Return to Developer Showcase
        </a>
      </div>

      <header class="mb-10 border-b border-paper-border dark:border-carbon-border pb-8">
        <span class="text-xs font-mono uppercase tracking-widest font-semibold text-blue-600 dark:text-blue-400">
          Architecture Case Study
        </span>
        <h1 class="font-serif text-3xl sm:text-5xl font-extrabold text-paper-text dark:text-carbon-text mt-2">
          {project.title}
        </h1>
        <p class="text-lg text-paper-muted dark:text-carbon-muted mt-4 font-serif leading-relaxed">
          {project.description}
        </p>

        <!-- Tech Badges -->
        <div class="flex flex-wrap gap-2 mt-6">
          {project.techStack.map((tech) => (
            <span class="text-xs font-mono font-medium px-3 py-1 rounded bg-paper-border/30 dark:bg-carbon-border/30 text-paper-text dark:text-carbon-text border border-paper-border/60 dark:border-carbon-border/60">
              {tech}
            </span>
          ))}
        </div>
      </header>

      <!-- Project Detail Body -->
      <article class="prose dark:prose-invert max-w-none text-paper-text dark:text-carbon-text leading-relaxed min-w-0 overflow-x-hidden">
        <h2 class="font-serif text-2xl font-bold mb-4">System Overview</h2>
        <p class="text-base sm:text-lg mb-8 font-serif leading-relaxed">
          {project.longDescription}
        </p>

        {/* Embedded Interactive React Quantization Studio for image-quantization project */}
        {slug === 'image-quantization' && (
          <div class="my-10 max-w-full overflow-hidden min-w-0">
            {/* Serendipitous Discovery Callout Box */}
            <div class="p-5 rounded-xl border border-purple-500/30 bg-purple-500/10 mb-6 font-serif">
              <span class="text-xs font-mono uppercase tracking-widest font-semibold text-purple-600 dark:text-purple-400 block mb-1">
                🔮 Serendipitous Printmaking Discovery: False CIELAB
              </span>
              <h4 class="font-bold text-lg mb-2 text-paper-text dark:text-carbon-text">
                The Happy Accident Behind "View From A Distance"
              </h4>
              <p class="text-sm text-paper-muted dark:text-carbon-muted leading-relaxed">
                Sometimes in computational printmaking, a software bug yields an unexpected masterpiece. While developing <code class="font-mono text-xs px-1 py-0.5 bg-paper-border/40 dark:bg-carbon-border/40 rounded">main.py</code>, a byte-mapping bug falsely interpreted raw sRGB pixel arrays directly as CIELAB <span class="font-mono text-xs">[L*, a*, b*]</span> coordinates before running K-Means clustering and converting back to RGB space. Rather than corrupting the image, this happy accident generated the surreal, hyper-vibrant ink palette used in the physical reduction edition <a href={getPrintUrl('view-from-a-distance')} class="text-purple-600 dark:text-purple-400 font-semibold underline">View From A Distance</a>.
              </p>
              <p class="text-xs text-purple-700 dark:text-purple-300 font-mono mt-3">
                👉 Select <strong>🔮 Serendipitous False CIELAB ("View From A Distance")</strong> in the studio toolbar below to experiment with this exact color palette transformation live!
              </p>
            </div>

            <h3 class="font-serif text-2xl font-bold mb-2">Interactive Browser Quantization Studio</h3>
            <p class="text-sm text-paper-muted dark:text-carbon-muted mb-4 font-serif">
              Upload custom image artwork or test sample presets to experiment with palette reduction, directional carving blurs, mother-color undertones, step-by-step reduction layer accumulation, and automated carving guides.
            </p>
            <QuantizationStudio client:load />
          </div>
        )}

        {/* Physical Printmaking Studio Application Gallery Cross-Links */}
        {slug === 'image-quantization' && (
          <section class="my-12 pt-8 border-t border-paper-border dark:border-carbon-border">
            <span class="text-xs font-mono uppercase tracking-widest font-semibold text-paper-accent dark:text-carbon-accent">
              Studio Applications
            </span>
            <h3 class="font-serif text-2xl font-bold mt-1 mb-2">Physical Prints Preprocessed with Image Quantization</h3>
            <p class="text-sm text-paper-muted dark:text-carbon-muted mb-6 font-serif">
              Explore physical reduction linocut editions pressed in the studio using palette layers and carving scripts calculated by this computational engine.
            </p>
            {relatedPrints.length > 0 ? (
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                {relatedPrints.map((artwork) => (
                  <ArtworkCard artwork={artwork} />
                ))}
              </div>
            ) : (
              <div class="p-6 bg-paper-border/20 dark:bg-carbon-border/20 rounded-xl text-center">
                <p class="text-xs text-paper-muted dark:text-carbon-muted font-mono">
                  Visit the <a href={DOMAINS.prints} class="text-blue-600 underline">Printmaker Studio Gallery</a> to view active physical reduction editions.
                </p>
              </div>
            )}
          </section>
        )}

        <!-- Repository Actions -->
        <div class="p-6 bg-paper-bg dark:bg-carbon-bg border border-paper-border dark:border-carbon-border rounded-xl flex items-center justify-between gap-4">
          <div>
            <h3 class="font-serif text-lg font-bold">Source Code & Repository</h3>
            <p class="text-xs text-paper-muted dark:text-carbon-muted">Inspect repository commits and architecture breakdowns.</p>
          </div>
          <div class="flex gap-3">
            {project.githubUrl && (
              <a 
                href={project.githubUrl} 
                target="_blank" 
                rel="noopener noreferrer"
                class="px-4 py-2 text-xs font-semibold rounded bg-paper-text text-paper-bg dark:bg-carbon-text dark:text-carbon-bg hover:opacity-90 transition-opacity"
              >
                GitHub Repo &rarr;
              </a>
            )}
            {hasExternalLiveUrl && (
              <a 
                href={project.liveUrl} 
                target="_blank" 
                rel="noopener noreferrer"
                class="px-4 py-2 text-xs font-semibold rounded border border-paper-border dark:border-carbon-border text-paper-text dark:text-carbon-text hover:bg-paper-border/30 dark:hover:bg-carbon-border/30 transition-colors"
              >
                Live Site &rarr;
              </a>
            )}
          </div>
        </div>
      </article>

    </main>

    <Footer />
  </body>
</html>
