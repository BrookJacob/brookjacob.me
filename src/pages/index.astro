---
/**
 * Root Portal Page (brookjacob.me)
 * 
 * Central portal highlighting Jacob Brook's software product ecosystem (ABLE Roadmap, Satori Trailheads,
 * brookjacob.me monorepo design) alongside tactile relief printmaking studio work.
 * 
 * @page
 */

import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Jacob Brook — Software Architect & Product Engineer</title>
    <meta 
      name="description" 
      content="Full-stack software architect building ABLE Roadmap and Satori Trailheads. Product engineering, web platforms, and tactile printmaking." 
    />
  </head>
  <body class="min-h-screen flex flex-col justify-between">
    <Navigation activeDomain="root" />

    <main class="flex-grow max-w-6xl mx-auto px-4 sm:px-6 py-12 sm:py-20 flex flex-col justify-center gap-16">
      
      <!-- Top Section: Developer & Platform Focused Editorial Intro -->
      <section class="max-w-3xl mx-auto text-center flex flex-col items-center gap-6">
        <span class="text-xs uppercase tracking-widest font-semibold px-3.5 py-1 border border-paper-border dark:border-carbon-border rounded-full text-paper-accent dark:text-carbon-accent bg-paper-border/20 dark:bg-carbon-border/20">
          Product Engineering & Platform Architecture
        </span>

        <h1 class="font-serif text-4xl sm:text-5xl md:text-6xl font-extrabold tracking-tight leading-[1.15] text-paper-text dark:text-carbon-text">
          Building platforms for direction, momentum, and growth.
        </h1>

        <p class="text-lg sm:text-xl text-paper-muted dark:text-carbon-muted leading-relaxed font-serif">
          Full-stack software architect behind <a href="https://ableroadmap.com" target="_blank" rel="noopener noreferrer" class="underline underline-offset-4 decoration-paper-accent dark:decoration-carbon-accent hover:text-paper-text dark:hover:text-carbon-text transition-colors">ABLE Roadmap</a> — a daily momentum coach & life roadmap workspace — and <a href="https://satoritrailheads.com" target="_blank" rel="noopener noreferrer" class="underline underline-offset-4 decoration-paper-accent dark:decoration-carbon-accent hover:text-paper-text dark:hover:text-carbon-text transition-colors">Satori Trailheads</a>. Crafting resilient web applications, interactive platforms, and tactile relief prints.
        </p>
      </section>

      <!-- Bottom Section: 50/50 Dual Canvas / Split Card Layout -->
      <section class="grid grid-cols-1 md:grid-cols-2 gap-8 items-stretch">
        
        <!-- Card 1 (Left): Printmaking Studio (Matching Header Nav Order) -->
        <a 
          href="/prints" 
          class="group relative flex flex-col justify-between p-8 sm:p-10 bg-paper-bg dark:bg-carbon-bg border border-paper-border dark:border-carbon-border rounded-2xl focus-tactile text-left no-underline transition-all overflow-hidden"
        >
          <!-- Organic Background Accent Glow -->
          <div class="absolute -right-12 -top-12 w-48 h-48 bg-paper-accent/10 dark:bg-carbon-accent/10 rounded-full blur-3xl pointer-events-none group-hover:scale-125 transition-transform duration-500"></div>

          <div>
            <div class="flex items-center justify-between mb-6">
              <span class="text-xs font-mono font-semibold uppercase tracking-widest text-paper-accent dark:text-carbon-accent">
                prints.brookjacob.me
              </span>
              <span class="text-xs font-serif italic text-paper-muted dark:text-carbon-muted">
                Studio Archive
              </span>
            </div>

            <h2 class="font-serif text-2xl sm:text-3xl font-bold text-paper-text dark:text-carbon-text mb-3 group-hover:text-paper-accent dark:group-hover:text-carbon-accent transition-colors">
              Printmaking Studio
            </h2>

            <p class="text-sm sm:text-base text-paper-muted dark:text-carbon-muted leading-relaxed">
              Discover original multi-layer reduction linocuts, edition archives, and process notes.
            </p>

            <!-- Craft Tag Highlights -->
            <div class="flex flex-wrap gap-2 mt-6">
              <span class="text-xs font-mono px-2.5 py-1 rounded bg-paper-accent/10 dark:bg-carbon-accent/10 text-paper-accent dark:text-carbon-accent border border-paper-accent/20">
                Reduction Linocuts
              </span>
              <span class="text-xs font-mono px-2.5 py-1 rounded bg-paper-border/30 dark:bg-carbon-border/30 text-paper-muted dark:text-carbon-muted">
                Edition Archives
              </span>
              <span class="text-xs font-mono px-2.5 py-1 rounded bg-paper-border/30 dark:bg-carbon-border/30 text-paper-muted dark:text-carbon-muted">
                Process Notes
              </span>
            </div>
          </div>

          <div class="mt-8 pt-6 border-t border-paper-border dark:border-carbon-border flex items-center justify-between font-semibold text-sm text-paper-text dark:text-carbon-text">
            <span>View Studio Archive</span>
            <span class="group-hover:translate-x-1 transition-transform">&rarr;</span>
          </div>
        </a>

        <!-- Card 2 (Right): Developer Showcase (Matching Header Nav Order) -->
        <a 
          href="/code" 
          class="group relative flex flex-col justify-between p-8 sm:p-10 bg-paper-bg dark:bg-carbon-bg border border-paper-border dark:border-carbon-border rounded-2xl focus-tech text-left no-underline transition-all overflow-hidden"
        >
          <!-- Crisp Tech Background Accent Glow -->
          <div class="absolute -right-12 -top-12 w-48 h-48 bg-blue-500/10 dark:bg-blue-400/10 rounded-full blur-3xl pointer-events-none group-hover:scale-125 transition-transform duration-500"></div>

          <div>
            <div class="flex items-center justify-between mb-6">
              <span class="text-xs font-mono font-semibold uppercase tracking-widest text-blue-600 dark:text-blue-400">
                code.brookjacob.me
              </span>
              <span class="text-xs font-serif italic text-paper-muted dark:text-carbon-muted">
                Systems & Platforms
              </span>
            </div>

            <h2 class="font-serif text-2xl sm:text-3xl font-bold text-paper-text dark:text-carbon-text mb-3 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">
              Developer Showcase
            </h2>

            <p class="text-sm sm:text-base text-paper-muted dark:text-carbon-muted leading-relaxed">
              Explore ABLE Roadmap, Satori Trailheads, and the design and architecture of brookjacob.me.
            </p>

            <!-- Product Tag Highlights -->
            <div class="flex flex-wrap gap-2 mt-6">
              <span class="text-xs font-mono px-2.5 py-1 rounded bg-blue-500/10 dark:bg-blue-400/10 text-blue-700 dark:text-blue-300 border border-blue-500/20">
                Able Roadmap
              </span>
              <span class="text-xs font-mono px-2.5 py-1 rounded bg-blue-500/10 dark:bg-blue-400/10 text-blue-700 dark:text-blue-300 border border-blue-500/20">
                Satori Trailheads
              </span>
              <span class="text-xs font-mono px-2.5 py-1 rounded bg-paper-border/30 dark:bg-carbon-border/30 text-paper-muted dark:text-carbon-muted">
                Monorepo Design
              </span>
            </div>
          </div>

          <div class="mt-8 pt-6 border-t border-paper-border dark:border-carbon-border flex items-center justify-between font-semibold text-sm text-paper-text dark:text-carbon-text">
            <span>Explore Developer Work</span>
            <span class="group-hover:translate-x-1 transition-transform">&rarr;</span>
          </div>
        </a>

      </section>

    </main>

    <Footer />
  </body>
</html>
