---
/**
 * Navigation Bar Component
 * 
 * Renders the top editorial navigation header across monorepo domains.
 * Includes domain indicator links for Root Portal, Printmaking, Code, and Blog,
 * integrated with Radix UI QuickNavMenu and MobileNavMenu primitives.
 * 
 * @component
 * @param {string} [activeDomain='root'] - Current active site target ('root' | 'prints' | 'code' | 'blog').
 */

import QuickNavMenu from './QuickNavMenu';
import MobileNavMenu from './MobileNavMenu';
import { getAllArtworks, getAllProjects } from '../lib/hygraph';
import { DOMAINS } from '../lib/urls';

interface Props {
  activeDomain?: 'root' | 'prints' | 'code' | 'blog';
}

const { activeDomain = 'root' } = Astro.props;

// Fetch latest artwork items and projects for Quick Jump dropdown menu
const artworks = await getAllArtworks();
const projects = await getAllProjects();

const latestPrints = artworks.slice(0, 2).map((a) => ({
  title: a.title,
  slug: a.slug,
  yearOrTag: `${a.year}`,
  url: `${DOMAINS.prints}/${a.slug}`,
}));

const latestProjects = projects.slice(0, 2).map((p) => ({
  title: p.title,
  slug: p.slug,
  yearOrTag: p.techStack[0] || 'Software',
  url: `${DOMAINS.code}/${p.slug}`,
}));
---

<header class="w-full border-b border-paper-border dark:border-carbon-border bg-paper-bg dark:bg-carbon-bg sticky top-0 z-40 transition-colors">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between gap-4">
    <!-- Brand / Home Link -->
    <a href={DOMAINS.portal} class="group flex items-center gap-2 text-paper-text dark:text-carbon-text no-underline">
      <span class="font-serif text-xl font-bold tracking-tight group-hover:text-paper-accent dark:group-hover:text-carbon-accent transition-colors">
        Jacob Brook
      </span>
      <span class="text-xs uppercase tracking-widest text-paper-muted dark:text-carbon-muted px-2 py-0.5 border border-paper-border dark:border-carbon-border rounded hidden sm:inline-block">
        Studio & Lab
      </span>
    </a>

    <!-- Right Controls: Quick Jump Menu + Navigation Links + Mobile Drawer -->
    <div class="flex items-center gap-3">
      <!-- Radix UI Quick Jump Dropdown Menu Primitive -->
      <QuickNavMenu client:load latestPrints={latestPrints} latestProjects={latestProjects} />

      <!-- Desktop Navigation Links (Hidden on small screens to prevent crowding) -->
      <nav class="hidden md:flex items-center gap-1 text-sm font-medium">
        

        <!-- Printmaking Portfolio Link -->
        <a 
          href={DOMAINS.prints} 
          class={`px-3 py-1.5 rounded-md transition-colors focus-tactile ${
            activeDomain === 'prints' 
              ? 'text-paper-accent dark:text-carbon-accent bg-paper-border/30 dark:bg-carbon-border/30 font-semibold' 
              : 'text-paper-muted dark:text-carbon-muted hover:text-paper-text dark:hover:text-carbon-text'
          }`}
        >
          Prints
        </a>

        <!-- Developer Portfolio Link -->
        <a 
          href={DOMAINS.code} 
          class={`px-3 py-1.5 rounded-md transition-colors focus-tech ${
            activeDomain === 'code' 
              ? 'text-blue-600 dark:text-blue-400 bg-paper-border/30 dark:bg-carbon-border/30 font-semibold' 
              : 'text-paper-muted dark:text-carbon-muted hover:text-paper-text dark:hover:text-carbon-text'
          }`}
        >
          Code
        </a>

        <!-- Blog Link -->
        <a 
          href={DOMAINS.blog} 
          class={`px-3 py-1.5 rounded-md transition-colors ${
            activeDomain === 'blog' 
              ? 'text-paper-accent dark:text-carbon-accent bg-paper-border/30 dark:bg-carbon-border/30 font-semibold' 
              : 'text-paper-muted dark:text-carbon-muted hover:text-paper-text dark:hover:text-carbon-text'
          }`}
        >
          Essays
        </a>
      </nav>

      <!-- Radix UI Sliding Mobile Menu Drawer Primitive -->
      <MobileNavMenu client:load activeDomain={activeDomain} />
    </div>
  </div>
</header>
