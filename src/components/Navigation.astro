---
/**
 * Navigation Bar Component
 * 
 * Renders the top editorial navigation header across monorepo domains.
 * Adapts to active domain:
 *  - prints & studio: Prints link, Bio button, and Instagram link.
 *  - code: Developer branding, Projects, Essays, Prints link, and GitHub link.
 * 
 * @component
 * @param {string} [activeDomain='root'] - Current active site target ('root' | 'prints' | 'code' | 'blog' | 'bio').
 */

import { MobileNavMenu } from './MobileNavMenu';
import { DOMAINS } from '../lib/urls';

interface Props {
  activeDomain?: 'root' | 'prints' | 'code' | 'blog' | 'bio';
}

const { activeDomain = 'root' } = Astro.props;
const isDevSubdomain = activeDomain === 'code';
---

<header class="w-full border-b border-paper-border dark:border-carbon-border bg-paper-bg dark:bg-carbon-bg sticky top-0 z-40 transition-colors">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between gap-4">
    <!-- Brand / Home Link -->
    {isDevSubdomain ? (
      <a 
        href={DOMAINS.code} 
        class="group flex items-center gap-2 text-paper-text dark:text-carbon-text no-underline"
        aria-label="Jacob Brook Developer Showcase — Return to Overview"
      >
        <span class="font-serif text-lg sm:text-xl font-bold tracking-tight group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">
          Jacob Brook
        </span>
        <span class="text-xs uppercase tracking-widest text-blue-600 dark:text-blue-400 px-2 py-0.5 border border-blue-500/30 rounded bg-blue-500/10 font-mono">
          Developer
        </span>
      </a>
    ) : (
      <a 
        href={DOMAINS.portal} 
        class="group flex items-center gap-2 text-paper-text dark:text-carbon-text no-underline"
        aria-label="Jacob Brook Studio & Lab — Return to Home"
      >
        <span class="brand-smallcaps text-base sm:text-lg text-paper-text dark:text-carbon-text group-hover:text-paper-accent dark:group-hover:text-carbon-accent transition-colors">
          Jacob Brook
        </span>
        <span class="text-xs uppercase tracking-widest text-paper-muted dark:text-carbon-muted px-2 py-0.5 border border-paper-border dark:border-carbon-border rounded">
          Studio & Lab
        </span>
      </a>
    )}

    <!-- Right Controls: Navigation Links + Mobile Drawer -->
    <div class="flex items-center gap-2 sm:gap-3">
      {isDevSubdomain ? (
        <nav class="hidden md:flex items-center gap-2 text-sm font-medium">
          <a 
            href={DOMAINS.code} 
            class={`px-3.5 py-1.5 rounded-lg transition-colors focus-tech ${
              activeDomain === 'code' 
                ? 'text-blue-600 dark:text-blue-400 bg-blue-500/10 font-semibold' 
                : 'text-paper-muted dark:text-carbon-muted hover:text-paper-text dark:hover:text-carbon-text'
            }`}
          >
            Projects
          </a>

          <a 
            href={DOMAINS.blog} 
            class="px-3.5 py-1.5 rounded-lg transition-colors text-paper-muted dark:text-carbon-muted hover:text-paper-text dark:hover:text-carbon-text"
          >
            Essays
          </a>

          <a 
            href="https://github.com/brookjacob" 
            target="_blank" 
            rel="noopener noreferrer"
            aria-label="Jacob Brook on GitHub"
            class="p-2 rounded-lg border border-paper-border dark:border-carbon-border hover:border-blue-500 dark:hover:border-blue-400 text-paper-muted dark:text-carbon-muted hover:text-blue-600 dark:hover:text-blue-400 transition-all flex items-center justify-center cursor-pointer ml-1"
            title="GitHub @brookjacob"
          >
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
              <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
            </svg>
          </a>
        </nav>
      ) : (
        <nav class="hidden md:flex items-center gap-2.5 text-sm font-medium">
          <a 
            href={DOMAINS.prints} 
            class={`px-3.5 py-1.5 rounded-lg transition-colors focus-tactile ${
              activeDomain === 'prints' 
                ? 'text-paper-accent dark:text-carbon-accent bg-paper-border/30 dark:bg-carbon-border/30 font-semibold' 
                : 'text-paper-muted dark:text-carbon-muted hover:text-paper-text dark:hover:text-carbon-text'
            }`}
          >
            Prints
          </a>

          <a 
            href={DOMAINS.bio} 
            class={`px-4 py-1.5 rounded-lg border text-sm font-medium transition-all focus-tactile ${
              activeDomain === 'bio'
                ? 'bg-paper-accent/15 dark:bg-carbon-accent/15 text-paper-accent dark:text-carbon-accent border-paper-accent/40 dark:border-carbon-accent/40 font-semibold shadow-xs'
                : 'border-paper-border dark:border-carbon-border text-paper-text dark:text-carbon-text hover:border-paper-accent dark:hover:border-carbon-accent hover:text-paper-accent dark:hover:text-carbon-accent bg-paper-border/10 dark:bg-carbon-border/10'
            }`}
          >
            Bio
          </a>

          <a 
            href="https://instagram.com/brook.jacob" 
            target="_blank" 
            rel="noopener noreferrer"
            aria-label="Jacob Brook on Instagram"
            class="p-2 rounded-lg border border-paper-border dark:border-carbon-border hover:border-paper-accent dark:hover:border-carbon-accent text-paper-muted dark:text-carbon-muted hover:text-paper-accent dark:hover:text-carbon-accent transition-all flex items-center justify-center cursor-pointer ml-1"
            title="Instagram @brook.jacob"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
              <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
              <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
              <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
            </svg>
          </a>
        </nav>
      )}

      <!-- Radix UI Sliding Mobile Menu Drawer Primitive (Hydrated only on mobile viewports) -->
      <MobileNavMenu client:media="(max-width: 768px)" activeDomain={activeDomain} />
    </div>
  </div>
</header>
