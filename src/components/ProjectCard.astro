---
/**
 * ProjectCard Component
 * 
 * Software engineering project card displaying title, tech stack badges,
 * summary, GitHub repository link, live deployment demo link, and tech focus hover effects.
 * 
 * @component
 * @param {Project} project - Project entity payload.
 */

import type { Project } from '../lib/types';

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<article class="group flex flex-col bg-paper-bg dark:bg-carbon-bg border border-paper-border dark:border-carbon-border rounded-xl p-6 focus-tech transition-all">
  <div class="flex items-start justify-between gap-4 mb-3">
    <h3 class="font-serif text-xl font-bold text-paper-text dark:text-carbon-text group-hover:text-paper-accent dark:group-hover:text-carbon-accent transition-colors">
      <a href={`/code/${project.slug}`}>
        {project.title}
      </a>
    </h3>

    <!-- External Link Actions -->
    <div class="flex items-center gap-2 text-paper-muted dark:text-carbon-muted">
      {project.githubUrl && (
        <a 
          href={project.githubUrl} 
          target="_blank" 
          rel="noopener noreferrer" 
          aria-label={`View GitHub repository for ${project.title}`}
          className="hover:text-paper-text dark:hover:text-carbon-text transition-colors p-1"
        >
          <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
            <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
          </svg>
        </a>
      )}
      {project.liveUrl && (
        <a 
          href={project.liveUrl} 
          target="_blank" 
          rel="noopener noreferrer" 
          aria-label={`Visit live demo for ${project.title}`}
          className="hover:text-paper-text dark:hover:text-carbon-text transition-colors p-1"
        >
          <svg class="w-5 h-5 fill-none stroke-current" viewBox="0 0 24 24" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" />
          </svg>
        </a>
      )}
    </div>
  </div>

  <!-- Description -->
  <p class="text-sm text-paper-muted dark:text-carbon-muted flex-grow mb-6 leading-relaxed">
    {project.description}
  </p>

  <!-- Tech Stack Badges -->
  <div class="flex flex-wrap gap-2 pt-4 border-t border-paper-border/60 dark:border-carbon-border/60">
    {project.techStack.map((tech) => (
      <span class="text-xs font-mono font-medium px-2.5 py-1 rounded bg-paper-border/30 dark:bg-carbon-border/30 text-paper-text dark:text-carbon-text">
        {tech}
      </span>
    ))}
  </div>
</article>
