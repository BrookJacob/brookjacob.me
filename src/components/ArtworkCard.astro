---
/**
 * ArtworkCard Component
 * 
 * Renders an artwork preview item for gallery feeds. Features medium-bleed image rendering
 * with Blurhash progressive loading canvas preview, technique tag, title, and clean edition metadata.
 * 
 * @component
 * @param {Artwork} artwork - Artwork entity payload.
 */

import type { Artwork } from '../lib/types';
import { BlurhashCanvas } from './BlurhashCanvas';
import { getPrintUrl } from '../lib/urls';
import {
  getPrintOrigin,
  getPrintEdition,
  formatPrintMedium,
  formatPrintPaper,
  formatPrintDimensions,
} from '../lib/printStories';

interface Props {
  artwork: Artwork;
}

const { artwork } = Astro.props;
const printUrl = getPrintUrl(artwork.slug);
const description = getPrintOrigin(artwork);
const edition = getPrintEdition(artwork);
const medium = formatPrintMedium(artwork);
const paper = formatPrintPaper(artwork);
const dimensions = formatPrintDimensions(artwork);

const specItems = [medium, paper, dimensions].filter(
  (item): item is string => typeof item === 'string' && item.trim().length > 0
);
---

<article class="group relative flex flex-col w-full text-left">
  <!-- Artwork Image Container: shows entire image without cropping -->
  <a 
    href={printUrl} 
    class="block overflow-hidden relative h-[380px] sm:h-[440px] md:h-[480px] w-full flex items-center justify-center bg-transparent"
  >
    <BlurhashCanvas
      client:load
      src={artwork.coverImage.url}
      alt={artwork.coverImage.altText || artwork.title}
      blurhash={artwork.coverImage.blurhash}
      className="w-full h-full object-contain"
      objectFit="contain"
    />
  </a>

  <!-- Museum Wall Label -->
  <div class="w-full mt-4 pt-1 font-mono text-left leading-relaxed">
    <div class="flex flex-wrap items-baseline justify-between gap-x-3 gap-y-1">
      <h3 class="font-serif text-lg sm:text-xl font-bold text-paper-text dark:text-carbon-text tracking-tight">
        <a href={printUrl} class="hover:text-paper-accent dark:hover:text-carbon-accent transition-colors">
          {artwork.title}
        </a>
        {artwork.year && (
          <span class="font-normal font-sans text-xs text-paper-muted dark:text-carbon-muted ml-2">
            {artwork.year}
          </span>
        )}
      </h3>

      {edition && (
        <span
          class="font-handwriting text-base sm:text-lg text-[#52504b] dark:text-[#a8a59f] select-none tracking-wide"
          title={`Edition: ${edition}`}
        >
          {edition}
        </span>
      )}
    </div>

    {specItems.length > 0 && (
      <p class="mt-1 text-[11px] text-paper-muted dark:text-carbon-muted tracking-tight font-mono">
        {specItems.map((item, idx) => (
          <span>
            {idx > 0 && <span class="mx-1.5 opacity-60">·</span>}
            {item}
          </span>
        ))}
      </p>
    )}

    {description && (
      <p class="mt-2 font-serif italic text-xs sm:text-sm text-paper-text/85 dark:text-carbon-text/85 leading-snug line-clamp-3">
        "{description}"
      </p>
    )}

    <div class="mt-3">
      <a
        href={printUrl}
        class="font-mono text-[11px] text-paper-accent dark:text-carbon-accent hover:underline inline-flex items-center gap-1 group"
      >
        <span>see this print</span>
        <span class="inline-block transition-transform group-hover:translate-x-0.5">&rarr;</span>
      </a>
    </div>
  </div>
</article>
