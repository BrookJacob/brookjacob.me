---
/**
 * Footer Component
 * 
 * Editorial footer providing copyright, domain portal index links,
 * GitHub repository reference, and accessibility statements.
 * 
 * @component
 */
---

<footer class="w-full border-t border-paper-border dark:border-carbon-border bg-paper-bg dark:bg-carbon-bg py-12 transition-colors">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 flex flex-col md:flex-row items-center justify-between gap-6">
    <!-- Editorial Studio Statement -->
    <div class="flex flex-col gap-1 text-center md:text-left">
      <p class="font-serif font-bold text-paper-text dark:text-carbon-text">
        Jacob Brook — Printmaking & Web Engineering
      </p>
      <p class="text-xs text-paper-muted dark:text-carbon-muted">
        Hand-carved relief prints & modern full-stack web applications.
      </p>
    </div>

    <!-- Domain Links & Copyright -->
    <div class="flex flex-col items-center md:items-end gap-2">
      <div class="flex items-center gap-4 text-xs font-medium text-paper-muted dark:text-carbon-muted">
        <a href="https://brookjacob.studio" class="hover:text-paper-accent dark:hover:text-carbon-accent transition-colors">brookjacob.studio</a>
        <span>•</span>
        <a href="https://printmaker.brookjacob.studio" class="hover:text-paper-accent dark:hover:text-carbon-accent transition-colors">printmaker.brookjacob.studio</a>
        <span>•</span>
        <a href="https://developer.brookjacob.studio" class="hover:text-paper-accent dark:hover:text-carbon-accent transition-colors">developer.brookjacob.studio</a>
      </div>
      <!-- Year and Copyright -->
      <p class="text-xs text-paper-muted dark:text-carbon-muted opacity-80">
        &copy; {new Date().getFullYear()} Jacob Brook. All rights reserved.
      </p>
    </div>
  </div>
</footer>
