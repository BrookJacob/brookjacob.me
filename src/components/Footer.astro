---
import { DOMAINS } from '../lib/urls';
---

<footer class="w-full border-t border-paper-border dark:border-carbon-border bg-paper-bg dark:bg-carbon-bg py-12 transition-colors">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 flex flex-col md:flex-row items-center justify-between gap-6">
    <!-- Editorial Studio Statement -->
    <div class="flex flex-col gap-1 text-center md:text-left">
      <p class="font-serif font-bold text-paper-text dark:text-carbon-text">
        Jacob Brook — Printmaking & Web Engineering
      </p>
      <p class="text-xs text-paper-muted dark:text-carbon-muted">
        Hand-carved relief prints & modern full-stack web applications.
      </p>
    </div>

    <!-- Domain Links & Copyright -->
    <div class="flex flex-col items-center md:items-end gap-3 text-center md:text-right">
      <div class="flex flex-wrap items-center justify-center md:justify-end gap-x-3 gap-y-1.5 text-xs font-medium text-paper-muted dark:text-carbon-muted">
        <a href={DOMAINS.portal} class="hover:text-paper-accent dark:hover:text-carbon-accent transition-colors whitespace-nowrap">brookjacob.studio</a>
        <span class="hidden sm:inline opacity-50">•</span>
        <a href={DOMAINS.prints} class="hover:text-paper-accent dark:hover:text-carbon-accent transition-colors whitespace-nowrap">printmaker.brookjacob.studio</a>
        <span class="hidden sm:inline opacity-50">•</span>
        <a href={DOMAINS.code} class="hover:text-paper-accent dark:hover:text-carbon-accent transition-colors whitespace-nowrap">developer.brookjacob.studio</a>
      </div>
      <!-- Year and Copyright -->
      <p class="text-xs text-paper-muted dark:text-carbon-muted opacity-80">
        &copy; {new Date().getFullYear()} Jacob Brook. All rights reserved.
      </p>
    </div>
  </div>
</footer>
